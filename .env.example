# cp .env.example .env 후 값을 채운다. .env 는 커밋되지 않는다.
# 서버는 요청마다 .env 를 다시 읽으므로 고친 뒤 재시작하지 않아도 된다.

# solved.ac API 키. https://backstage.solved.ac/ko/developer/apps 에서 앱을 등록하면 발급된다.
SOLVEDAC_CLIENT_ID=
SOLVEDAC_CLIENT_SECRET=

# 내 BOJ 핸들. 문제를 뽑을 때 이미 푼 문제를 빼고, AC 를 확인할 때 쓴다.
BOJ_HANDLE=

# (선택) 문제 뽑기 기본 쿼리. 기본값은 *g (골드 전체).
# oj:boj 와 -@BOJ_HANDLE 은 자동으로 붙는다. 예: *g5..g3 s#1000.. lang:ko
# SOLVEDAC_QUERY=*g
